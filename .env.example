# credimi-federation configuration. Copy to .env; contains no secrets.

# Public Entity Identifier: an https origin without path, query or fragment.
# Every advertised URL is derived from it; request Host headers are never used.
FEDERATION_ENTITY_ID=https://federation.credimi.io

# TCP port the service listens on (bound to 0.0.0.0).
PORT=3000

# Private ES256 federation signing key, created once by `credimi-federation init`.
# Set exactly ONE of the two variables below; both or neither stops the service.
# For local development use ./data/keys/federation.jwk and ./data/subordinates.json.
FEDERATION_SIGNING_KEY_PATH=/data/keys/federation.jwk
# Alternative for platforms without a writable volume (e.g. Coolify): the key
# file's content on one line (`tr -d ' \n' < federation.jwk`), stored as a secret.
# FEDERATION_SIGNING_KEY=

# Local registry (public keys only): hand-edited or managed by the admin area.
FEDERATION_SUBORDINATES_PATH=/data/subordinates.json

# GitHub registry: one file per subordinate, added by pull request.
# For local development use ./registry; the Docker image sets /app/registry.
FEDERATION_REGISTRY_DIR=/app/registry

# Optional display name shown on the website.
FEDERATION_NAME=Credimi Test Federation

# Optional admin area at /admin for demo and testing (at least 16 characters).
# Set it only in .env or as a platform secret; leave it unset in production.
# FEDERATION_ADMIN_PASSWORD=
